// Cotonia data model.
//
// Local development uses SQLite. For production, switch the provider to
// "postgresql" and point DATABASE_URL at the hosted database.
// Enum-like columns are stored as strings; their allowed values live in
// src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String // RETAILER | WHOLESALER | ADMIN
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  retailer      RetailerProfile?
  store         Store?
  cartItems     CartItem[]
  favorites     Favorite[]
  orders        Order[]
  conversations Conversation[]
  messages      Message[]
  rfqs          Rfq[]
  reviews       Review[]
  recentViews   RecentView[]
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Business profile of a buyer (clothing shop, online store, chain...).
model RetailerProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  shopName     String
  businessType String // BOUTIQUE | ONLINE_STORE | CHAIN | DEPARTMENT_STORE | DISTRIBUTOR | OTHER
  country      String // ISO 3166-1 alpha-2
  city         String
  address      String?
  taxNumber    String?
  website      String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Business profile and public storefront of a supplier.
model Store {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  slug           String   @unique
  tagline        String?
  description    String?
  businessType   String // MANUFACTURER | WHOLESALER | IMPORTER
  country        String
  city           String
  address        String?
  foundedYear    Int?
  minOrderAmount Float    @default(0) // USD, per order
  shippingInfo   String?
  paymentInfo    String?
  whatsapp       String?
  brandColor     String   @default("#FF6B57")
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Company profile (shown on the supplier's "Company profile" tab)
  employees       String? // e.g. "51-100"
  factorySize     Int? // m²
  productionLines Int?
  monthlyCapacity String? // e.g. "60,000 pieces"
  annualRevenue   String? // e.g. "US$2.5M - 5M"
  exportMarkets   String  @default("[]") // JSON [{ "region": "Europe", "share": 40 }]
  mainProducts    String?
  certifications  String? // comma separated

  products      Product[]
  orders        Order[]
  conversations Conversation[]
  quotes        RfqQuote[]
  reviews       Review[]
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  nameTranslations String @default("{}") // JSON { "ar": "..." }: name in other languages
  art       String    @default("tshirt") // illustration used for tiles and placeholders
  color     String    @default("#FFD166")
  sortOrder Int       @default(0)
  products  Product[]
  rfqs      Rfq[]
}

model Product {
  id              String   @id @default(cuid())
  storeId         String
  categoryId      String
  sku             String
  slug            String   @unique
  name            String
  nameTranslations String  @default("{}") // JSON { "ar": "..." }: name in other languages
  description     String
  gender          String // GIRL | BOY | UNISEX
  ageGroup        String // BABY | KIDS | JUNIOR
  season          String // SPRING_SUMMER | AUTUMN_WINTER | ALL_SEASON
  fabric          String
  origin          String // ISO country code
  sizes           String // JSON array: one piece of each size makes one series
  pricePerPiece   Float // USD, base price
  priceTiers      String   @default("[]") // JSON [{ "minSeries": 10, "pricePerPiece": 4.2 }]
  minSeries       Int      @default(1) // minimum series per order for this product
  weightPerSeries Float? // kg
  status          String   @default("ACTIVE") // ACTIVE | DRAFT
  hiddenByAdmin   Boolean  @default(false)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Production, samples and customization
  readyToShip        Boolean @default(true) // false = made to order
  leadTimeDays       Int     @default(7) // days until dispatch
  sampleAvailable    Boolean @default(true)
  samplePrice        Float? // USD for one sample series
  customLogoMoq      Int? // series needed for a custom logo
  customPackagingMoq Int? // series needed for custom packaging
  seriesPerCarton    Int?
  cartonSize         String? // e.g. "60 x 40 x 40 cm"

  // Counters shown on cards (kept in sync by the app)
  viewCount   Int   @default(0)
  soldSeries  Int   @default(0)
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category       @relation(fields: [categoryId], references: [id])
  colors      ProductColor[]
  cartItems   CartItem[]
  favorites   Favorite[]
  orderItems  OrderItem[]
  messages    Message[]
  reviews     Review[]
  recentViews RecentView[]

  @@unique([storeId, sku])
  @@index([categoryId])
  @@index([storeId])
}

model ProductColor {
  id        String     @id @default(cuid())
  productId String
  name      String
  hex       String
  imageUrl  String
  stock     Int        @default(0) // series available
  sortOrder Int        @default(0)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
}

// ---------------------------------------------------------------------------
// Buying
// ---------------------------------------------------------------------------

model CartItem {
  id        String       @id @default(cuid())
  userId    String
  productId String
  colorId   String
  series    Int
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([userId, colorId])
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

// One order per wholesaler. Checkout splits a mixed cart into several orders.
model Order {
  id             String   @id @default(cuid())
  number         String   @unique
  retailerId     String
  storeId        String
  status         String   @default("PENDING") // PENDING | CONFIRMED | PAID | SHIPPED | DELIVERED | CANCELLED
  subtotal       Float
  shippingCost   Float?
  shippingMethod String // SELLER_SHIPS | BUYER_CARGO
  shipCountry    String
  shipCity       String
  shipAddress    String
  contactPhone   String?
  buyerNote      String?
  sellerNote     String?
  trackingNumber String?
  isSample       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  retailer User         @relation(fields: [retailerId], references: [id])
  store    Store        @relation(fields: [storeId], references: [id])
  items    OrderItem[]
  events   OrderEvent[]

  @@index([retailerId])
  @@index([storeId])
}

// Snapshot of what was ordered, so later product edits don't change old orders.
model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?
  colorId         String? // used to reserve and release stock
  productName     String
  sku             String
  colorName       String
  colorHex        String
  imageUrl        String
  sizes           String // JSON array
  series          Int
  piecesPerSeries Int
  pricePerPiece   Float
  lineTotal       Float
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Messaging (one thread per retailer and wholesaler)
// ---------------------------------------------------------------------------

model Conversation {
  id             String    @id @default(cuid())
  retailerId     String
  storeId        String
  lastMessage    String    @default("")
  lastMessageAt  DateTime  @default(now())
  retailerUnread Int       @default(0)
  sellerUnread   Int       @default(0)
  createdAt      DateTime  @default(now())
  retailer       User      @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([retailerId, storeId])
  @@index([storeId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  productId      String? // product the message asks about
  rfqId          String? // buying request the message refers to
  quantity       Int? // series the buyer is interested in
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  rfq            Rfq?         @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Buying requests (RFQ): retailers post needs, wholesalers send quotes
// ---------------------------------------------------------------------------

model Rfq {
  id          String     @id @default(cuid())
  number      String     @unique
  retailerId  String
  categoryId  String?
  title       String
  details     String
  quantity    Int // pieces
  targetPrice Float? // USD per piece
  destination String // ISO country code
  status      String     @default("OPEN") // OPEN | CLOSED
  expiresAt   DateTime
  createdAt   DateTime   @default(now())
  retailer    User       @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quotes      RfqQuote[]
  messages    Message[]

  @@index([status, createdAt])
}

model RfqQuote {
  id            String   @id @default(cuid())
  rfqId         String
  storeId       String
  pricePerPiece Float
  minQuantity   Int // pieces
  leadTimeDays  Int
  message       String
  status        String   @default("SENT") // SENT | ACCEPTED | DECLINED
  createdAt     DateTime @default(now())
  rfq           Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([rfqId, storeId])
}

// ---------------------------------------------------------------------------
// Reviews and browsing history
// ---------------------------------------------------------------------------

// A buyer reviews a product after an order with it was delivered.
model Review {
  id         String   @id @default(cuid())
  productId  String
  storeId    String
  retailerId String
  rating     Int // 1-5
  comment    String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  retailer   User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@unique([retailerId, productId])
  @@index([storeId])
}

model RecentView {
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, viewedAt])
}
